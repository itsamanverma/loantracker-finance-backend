{
  "name": "loantracker-pro-backend",
  "version": "1.0.0",
  "description": "Monolithic backend for LoanTracker Pro using Fastify, Prisma, PostgreSQL and Redis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "tunnel": "bash scripts/pinggy-tunnel.sh",
    "tunnel:port": "bash scripts/pinggy-tunnel.sh $npm_config_port",
    "tunnel:cf": "bash scripts/cloudflare-tunnel.sh",
    "tunnel:cf:port": "bash scripts/cloudflare-tunnel.sh $npm_config_port"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1063.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^5.14.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.12",
    "cloudflared": "^0.7.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
